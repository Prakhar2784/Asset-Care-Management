PORT=5000
MONGO_URI=mongodb://localhost:27017/assetcare
JWT_SECRET=replace_with_a_long_random_secret
NODE_ENV=development

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api

# Used by scripts/createSuperAdmin.js
ADMIN_EMAIL=admin@example.com

# Optional: Google reCAPTCHA v2/v3 secret. When set, the login endpoint
# enforces CAPTCHA after 3 consecutive failed attempts. Leave blank to
# disable server-side CAPTCHA enforcement (the API still returns a
# captchaRequired flag so the frontend can render a widget).
RECAPTCHA_SECRET_KEY=

# Razorpay Payment Gateway Configuration (Test Mode & Live Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Cloudinary Cloud Storage Configuration (Optional - falls back to local disk if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# System Licensing Secret
LICENSE_SECRET=assetcare_commercial_license_secret_key_2026

# Optional cloud link for Desktop Installer download
DESKTOP_APP_DOWNLOAD_URL=https://drive.google.com/uc?export=download&id=1sf8xo6AAX5_d07goJndeuNxtpvILHoRs

