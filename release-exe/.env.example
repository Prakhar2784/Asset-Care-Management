# Port on which the local application server will run
PORT=5000

# MongoDB Connection URI (Replace with your own local MongoDB URI or MongoDB Atlas cloud URI)
# Example: mongodb+srv://username:password@cluster.mongodb.net/database_name
MONGO_URI=mongodb://localhost:27017/asset-care-system

# Secret key used for signing JWT tokens (Generate a strong random string)
JWT_SECRET=your_super_secret_jwt_key_here

# Run mode (development/production)
NODE_ENV=production

# Email SMTP Settings (For ticket assignments, alerts, and notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password

# URLs for internal routing (Usually leave as localhost when running locally)
FRONTEND_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000/api

# Optional: Set this to a direct public download URL (e.g. AWS S3, Google Drive, Dropbox) 
# for the asset-care-setup.exe. If set, the portal's download button will redirect 
# to this URL. If empty, the server will try to serve the local asset-care-setup.exe.
DESKTOP_APP_DOWNLOAD_URL=

