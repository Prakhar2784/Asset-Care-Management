{
  "name": "asset-care-backend",
  "version": "1.0.0",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.1",
    "multer": "^2.2.0",
    "node-cron": "^4.5.0",
    "nodemailer": "^9.0.1",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "streamifier": "^0.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "pkg": "^5.8.1"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:frontend": "npm run build --prefix ../frontend",
    "build": "npm run build:frontend",
    "build:exe": "npm run build:frontend && pkg . --targets node18-win-x64 --out-path ./dist"
  },
  "bin": "server.js",
  "pkg": {
    "assets": [
      "config/**/*",
      "controllers/**/*",
      "jobs/**/*",
      "middleware/**/*",
      "models/**/*",
      "routes/**/*",
      "services/**/*",
      "utils/**/*",
      "validation/**/*",
      "../frontend/dist/**/*"
    ]
  }
}
